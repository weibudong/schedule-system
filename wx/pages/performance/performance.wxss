.perf-page {
  min-height: 100vh;
}

.perf-header {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}

.perf-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.perf-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chev {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #9ca3af;
  border-bottom: 3rpx solid #9ca3af;
  transform: rotate(45deg) translateY(-3rpx);
  margin-left: 10rpx;
  flex-shrink: 0;
}

.user-picker {
  display: flex;
  align-items: center;
  height: 56rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #374151;
  background: #f5f6f8;
  max-width: 200rpx;
}

.user-picker:active {
  background: #eef0f3;
}

.user-picker-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-btn {
  padding: 8rpx 14rpx;
  font-size: 24rpx;
  color: #6b7280;
  border-radius: 12rpx;
}

.name-btn:active {
  background: #f3f4f6;
}

/* 筛选区 */
.filter-bar {
  background: #fff;
  border-bottom: 1rpx solid #f3f4f6;
  padding: 20rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.filter-picker {
  display: flex;
  align-items: center;
  height: 60rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #374151;
  background: #f5f6f8;
}

.filter-picker:active {
  background: #eef0f3;
}

.filter-type {
  background: #eff6ff;
  color: #2563eb;
  font-weight: 500;
}

.date-range {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.range-sep {
  color: #9ca3af;
}

.filter-row2 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
}

.search-btn {
  display: flex;
  align-items: center;
  height: 60rpx;
  box-sizing: border-box;
  padding: 0 36rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.search-btn:active {
  opacity: 0.85;
}

/* 合计金额 */
.total-card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total-label {
  font-size: 26rpx;
  color: #6b7280;
}

.total-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #ef4444;
}

/* 状态卡片 */
.status-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin: 20rpx 32rpx;
}

.status-card {
  border-radius: 16rpx;
  padding: 20rpx;
  border: 4rpx solid transparent;
}

.bg-green { background: #f0fdf4; }
.bg-orange { background: #fff7ed; }
.bg-blue { background: #eff6ff; }
.bg-gray { background: #f9fafb; }

.ring-green { border-color: #22c55e; }
.ring-orange { border-color: #f97316; }
.ring-blue { border-color: #3b82f6; }
.ring-gray { border-color: #6b7280; }

.status-card-label {
  font-size: 22rpx;
}

.status-card-count {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

.t-green { color: #16a34a; }
.t-green-d { color: #15803d; }
.t-orange { color: #ea580c; }
.t-orange-d { color: #c2410c; }
.t-blue { color: #2563eb; }
.t-blue-d { color: #1d4ed8; }
.t-gray { color: #4b5563; }
.t-gray-d { color: #374151; }

/* 业绩列表 */
.perf-list {
  background: #fff;
  margin: 0 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.perf-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.perf-item:active {
  background: #f9fafb;
}

.perf-item-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.perf-item-title {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
  line-height: 1.5;
}

.perf-item-tags {
  display: flex;
  gap: 10rpx;
}

.mini-tag {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.mini-blue { background: #dbeafe; color: #1d4ed8; }
.mini-gray { background: #f3f4f6; color: #4b5563; }
.mini-green { background: #dcfce7; color: #15803d; }
.mini-orange { background: #ffedd5; color: #c2410c; }

.perf-item-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}

.perf-item-label {
  font-size: 22rpx;
  color: #6b7280;
}

.perf-item-value {
  font-size: 24rpx;
  color: #1f2937;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

.bottom-space {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

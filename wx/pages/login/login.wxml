<view class="login-page">
  <view class="login-card">
    <view class="login-title">日程系统</view>

    <view class="login-field">
      <view class="login-label">手机号</view>
      <input class="login-input" type="number" value="{{phone}}" placeholder="请输入手机号" placeholder-class="ph" bindinput="onPhoneInput" />
    </view>

    <view class="login-field">
      <view class="login-label">密码</view>
      <input class="login-input" password value="{{password}}" placeholder="请输入密码" placeholder-class="ph" bindinput="onPasswordInput" />
    </view>

    <view wx:if="{{error}}" class="login-error">{{error}}</view>

    <view class="login-btn {{loading ? 'loading' : ''}}" bindtap="handleLogin">
      {{loading ? '登录中...' : '登录'}}
    </view>
  </view>
</view>

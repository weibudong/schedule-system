.login-page {
  min-height: 100vh;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.login-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 56rpx 48rpx;
  width: 100%;
  max-width: 640rpx;
  box-sizing: border-box;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #1f2937;
  margin-bottom: 48rpx;
}

.login-field {
  margin-bottom: 32rpx;
}

.login-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 14rpx;
}

.login-input {
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  padding: 0 28rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1f2937;
  background: #f5f6f8;
}

.login-input:focus {
  border-color: #bfdbfe;
  background: #fff;
}

.login-error {
  color: #ef4444;
  font-size: 24rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.login-btn {
  width: 100%;
  background: #3b82f6;
  color: #fff;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.login-btn:active {
  background: #2563eb;
}

.login-btn.loading {
  opacity: 0.7;
}

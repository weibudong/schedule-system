.cal-page {
  min-height: 100vh;
}

/* 顶部控制栏 */
.topbar {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 30;
}

.month-nav {
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #4b5563;
  border-radius: 12rpx;
}

.nav-btn:active {
  background: #f3f4f6;
  color: #111827;
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  padding: 8rpx 12rpx;
}

.month-title:active {
  color: #2563eb;
}

.month-arrow {
  font-size: 24rpx;
  color: #6b7280;
  margin-left: 6rpx;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.user-picker {
  display: flex;
  align-items: center;
  height: 56rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #374151;
  background: #f5f6f8;
  max-width: 190rpx;
}

.user-picker:active {
  background: #eef0f3;
}

.user-picker-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chev {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #9ca3af;
  border-bottom: 3rpx solid #9ca3af;
  transform: rotate(45deg) translateY(-3rpx);
  margin-left: 10rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.add-btn {
  color: #2563eb;
  font-size: 40rpx;
  font-weight: 600;
}

.add-btn:active {
  background: #eff6ff;
}

.user-btn {
  font-size: 30rpx;
}

.user-btn:active {
  background: #f0fdf4;
}

.name-btn {
  padding: 8rpx 14rpx;
  font-size: 24rpx;
  color: #6b7280;
  border-radius: 12rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-btn:active {
  background: #f3f4f6;
  color: #374151;
}

/* 月份选择弹层 */
.month-panel {
  position: absolute;
  top: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  padding: 24rpx;
  width: 520rpx;
  box-sizing: border-box;
}

.month-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.picker-nav {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #4b5563;
  border-radius: 8rpx;
}

.picker-nav:active {
  background: #f3f4f6;
}

.picker-year {
  font-size: 28rpx;
  font-weight: 500;
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.month-cell {
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #374151;
  border-radius: 8rpx;
}

.month-cell:active {
  background: #f3f4f6;
}

.month-cell.active {
  background: #3b82f6;
  color: #fff;
}

/* 星期表头 */
.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: #f3f4f6;
  border-bottom: 1rpx solid #e5e7eb;
}

.week-cell {
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: #4b5563;
  padding: 14rpx 0;
}

.week-cell.weekend {
  color: #ef4444;
}

/* 日历格子 */
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  border-left: 1rpx solid #e5e7eb;
}

.cal-cell {
  min-height: 168rpx;
  padding: 2rpx;
  border-right: 1rpx solid #e5e7eb;
  border-bottom: 1rpx solid #e5e7eb;
  background: #fff;
  box-sizing: border-box;
}

.cal-cell.other-month {
  background: #f9fafb;
}

.cal-cell.today {
  background: #eff6ff;
}

.cell-date {
  font-size: 20rpx;
  text-align: center;
  color: #374151;
}

.cell-date.dim {
  color: #d1d5db;
}

.cell-date.weekend {
  color: #ef4444;
}

.chip {
  display: flex;
  align-items: center;
  font-size: 18rpx;
  line-height: 1.3;
  padding: 4rpx 4rpx;
  border-radius: 6rpx;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chip-paid {
  background: #dcfce7;
  color: #15803d;
}

.chip-paid:active {
  background: #bbf7d0;
}

.chip-unpaid {
  background: #fee2e2;
  color: #b91c1c;
}

.chip-unpaid:active {
  background: #fecaca;
}

.chip-icon {
  font-size: 16rpx;
  margin-right: 2rpx;
  flex-shrink: 0;
}

/* 汇总卡片 */
.summary-card {
  background: #fff;
  margin: 24rpx 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.summary-label {
  font-size: 26rpx;
  color: #4b5563;
}

.summary-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #f97316;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  padding: 28rpx 32rpx;
}

.summary-item {
  text-align: center;
}

.summary-item-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.summary-item-value {
  font-size: 34rpx;
  font-weight: 700;
}

.c-blue { color: #2563eb; }
.c-green { color: #16a34a; }
.c-purple { color: #9333ea; }
.c-orange { color: #ea580c; }
.c-gray { color: #1f2937; }

.bottom-space {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.tabbar {
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #f0f1f3;
  box-shadow: 0 -4rpx 24rpx rgba(17, 24, 39, 0.05);
  padding: 10rpx 24rpx calc(10rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabbar-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.tabbar-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  transition: background 0.2s;
}

.pill-active {
  background: #eff6ff;
}

.tabbar-icon {
  font-size: 34rpx;
  line-height: 1;
  filter: grayscale(1);
  opacity: 0.55;
}

.pill-active .tabbar-icon {
  filter: none;
  opacity: 1;
}

.tabbar-text {
  font-size: 26rpx;
  color: #9ca3af;
  font-weight: 500;
}

.pill-active .tabbar-text {
  color: #2563eb;
  font-weight: 600;
}

<view class="tabbar" wx:if="{{visible}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar-item {{selected === index ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <view class="tabbar-pill {{selected === index ? 'pill-active' : ''}}">
      <text class="tabbar-icon">{{item.icon}}</text>
      <text class="tabbar-text">{{item.text}}</text>
    </view>
  </view>
</view>

.am-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.am-panel {
  background: #fff;
  width: 100%;
  max-height: 92vh;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部把手 */
.am-handle-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 4rpx;
  flex-shrink: 0;
}

.am-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

/* 头部 */
.am-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
  flex-shrink: 0;
}

.am-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.am-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.am-no {
  font-size: 22rpx;
  color: #9ca3af;
}

.am-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7280;
  font-size: 26rpx;
  border-radius: 50%;
  background: #f3f4f6;
}

.am-close:active {
  background: #e5e7eb;
}

/* 表单主体 */
.am-body {
  flex: 1 1 auto;
  min-height: 0;
  height: 54vh;
  padding: 4rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.am-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.am-row-top {
  align-items: flex-start;
}

.am-label {
  font-size: 26rpx;
  color: #9ca3af;
  width: 140rpx;
  flex-shrink: 0;
}

.label-top {
  padding-top: 26rpx;
}

.am-control {
  flex: 1;
  min-width: 0;
}

/* 统一控件样式：灰底圆角，无边框 */
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1f2937;
}

.field:active:not(.field-disabled) {
  background: #eef0f3;
}

.field-disabled {
  background: #f3f4f6;
  color: #9ca3af;
}

.field-error {
  border-color: #fca5a5;
  background: #fef2f2;
}

.field-ph {
  color: #b6bcc6;
}

.field-input {
  display: block;
  height: 84rpx;
}

.field-textarea {
  display: block;
  height: 190rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
  text-align: left;
}

/* 小三角箭头 */
.chev {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #b6bcc6;
  border-bottom: 3rpx solid #b6bcc6;
  transform: rotate(45deg) translateY(-4rpx);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.chev.up {
  transform: rotate(-135deg) translateY(-2rpx);
}

/* 日期行双控件 */
.date-row {
  display: flex;
  gap: 16rpx;
}

.date-picker {
  flex: 1.35;
  min-width: 0;
}

.period-picker {
  flex: 1;
  min-width: 0;
}

/* 公司搜索下拉 */
.company-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-dropdown {
  margin-top: 12rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(17, 24, 39, 0.1);
  border: 1rpx solid #f0f1f3;
  overflow: hidden;
}

.company-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.company-search-icon {
  font-size: 24rpx;
  opacity: 0.6;
}

.company-search-input {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
}

.company-list {
  max-height: 380rpx;
}

.company-empty {
  padding: 28rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.company-item {
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  color: #374151;
}

.company-item:active {
  background: #f5f8ff;
}

.company-item.active {
  background: #eff6ff;
  color: #2563eb;
  font-weight: 500;
}

/* 金额输入 */
.amount-wrap {
  gap: 12rpx;
}

.amount-symbol {
  color: #9ca3af;
  font-size: 28rpx;
  flex-shrink: 0;
}

.amount-unit {
  color: #9ca3af;
  font-size: 24rpx;
  flex-shrink: 0;
}

.amount-input {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
  background: transparent;
}

/* 提示与错误 */
.error-text {
  font-size: 22rpx;
  color: #ef4444;
  margin-top: 10rpx;
  display: block;
}

.hint-text {
  font-size: 22rpx;
  color: #b6bcc6;
  margin-top: 10rpx;
  display: block;
}

/* 状态卡片 */
.status-card {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.status-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-card-title {
  font-size: 26rpx;
  color: #9ca3af;
}

.status-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-blue {
  background: #dbeafe;
  color: #1d4ed8;
}

.tag-green {
  background: #dcfce7;
  color: #15803d;
}

.tag-orange {
  background: #ffedd5;
  color: #c2410c;
}

.tag-gray {
  background: #ebedf0;
  color: #6b7280;
}

.status-sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.status-sub-text {
  font-size: 22rpx;
  color: #9ca3af;
}

.status-sub-link {
  font-size: 22rpx;
  color: #2563eb;
  padding: 2rpx 8rpx;
}

.status-sub-link:active {
  opacity: 0.7;
}

/* 底部 */
.am-footer {
  flex-shrink: 0;
  border-top: 1rpx solid #f3f4f6;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
}

/* 操作确认面板 */
.action-panel {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.action-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 18rpx;
}

.action-title-bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #2563eb;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.action-label {
  font-size: 24rpx;
  color: #6b7280;
  width: 120rpx;
  flex-shrink: 0;
}

.action-picker {
  flex: 1;
}

.action-input {
  flex: 1;
  display: block;
}

.action-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}

.action-cancel {
  background: #e5e7eb;
  color: #374151;
}

/* 按钮组 */
.footer-btns {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.footer-btn {
  flex: 1;
  min-width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 14rpx;
  font-size: 25rpx;
}

/* 按钮基础样式（组件内本地定义，避免样式隔离影响） */
.btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.btn:active {
  opacity: 0.85;
}

.btn-blue {
  background: #2563eb;
  color: #fff;
}

.btn-green {
  background: #16a34a;
  color: #fff;
}

.btn-orange {
  background: #ea580c;
  color: #fff;
}

.btn-red {
  background: #dc2626;
  color: #fff;
}

.btn-disabled {
  background: #e5e7eb;
  color: #9ca3af;
}

.btn-disabled:active {
  opacity: 1;
}

/* placeholder 颜色 */
.ph {
  color: #b6bcc6;
  font-size: 28rpx;
}

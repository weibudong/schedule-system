<view wx:if="{{visible}}" class="am-mask" bindtap="close">
  <view class="am-panel" catchtap="noop">
    <!-- 顶部把手 -->
    <view class="am-handle-bar">
      <view class="am-handle"></view>
    </view>

    <!-- 头部 -->
    <view class="am-header">
      <view class="am-title-wrap">
        <view class="am-title">{{appointment ? '查看行程' : '添加行程'}}</view>
        <view wx:if="{{appointment}}" class="am-no">No.{{appointment.id}}</view>
      </view>
      <view class="am-close" bindtap="close">✕</view>
    </view>

    <!-- 表单区 -->
    <scroll-view scroll-y class="am-body" enhanced show-scrollbar="{{false}}">
      <!-- 行程日期 -->
      <view class="am-row">
        <text class="am-label">行程日期</text>
        <view class="am-control date-row">
          <picker mode="date" value="{{form.date}}" disabled="{{isFieldDisabled}}" bindchange="onDateChange" class="date-picker">
            <view class="field {{isFieldDisabled ? 'field-disabled' : ''}}">
              <text>{{form.date}}</text>
              <view class="chev"></view>
            </view>
          </picker>
          <picker mode="selector" range="{{timePeriods}}" value="{{timePeriodIndex}}" disabled="{{isFieldDisabled}}" bindchange="onTimePeriodChange" class="period-picker">
            <view class="field {{isFieldDisabled ? 'field-disabled' : ''}}">
              <text>{{form.timePeriod}}</text>
              <view class="chev"></view>
            </view>
          </picker>
        </view>
      </view>

      <!-- 课程类型 -->
      <view class="am-row">
        <text class="am-label">课程类型</text>
        <view class="am-control">
          <picker mode="selector" range="{{types}}" value="{{typeIndex}}" disabled="{{isFieldDisabled}}" bindchange="onTypeChange">
            <view class="field {{isFieldDisabled ? 'field-disabled' : ''}}">
              <text>{{form.type}}</text>
              <view class="chev"></view>
            </view>
          </picker>
        </view>
      </view>

      <!-- 执行人员 -->
      <view class="am-row">
        <text class="am-label">执行人员</text>
        <view class="am-control">
          <picker mode="selector" range="{{teacherNames}}" value="{{teacherIndex}}" disabled="{{isFieldDisabled}}" bindchange="onTeacherChange">
            <view class="field {{isFieldDisabled ? 'field-disabled' : ''}}">
              <text>{{teacherNames[teacherIndex] || '请选择'}}</text>
              <view class="chev"></view>
            </view>
          </picker>
        </view>
      </view>

      <!-- 所在地区 -->
      <view class="am-row">
        <text class="am-label">所在地区</text>
        <view class="am-control date-row">
          <picker mode="selector" range="{{provinceLabels}}" value="{{provinceIndex < 0 ? 0 : provinceIndex}}" disabled="{{isFieldDisabled}}" bindchange="onProvinceChange" class="date-picker">
            <view class="field {{isFieldDisabled ? 'field-disabled' : ''}}">
              <text class="{{form.province ? '' : 'field-ph'}}">{{form.province || '省份'}}</text>
              <view class="chev"></view>
            </view>
          </picker>
          <picker mode="selector" range="{{cityList}}" value="{{cityIndex < 0 ? 0 : cityIndex}}" disabled="{{isFieldDisabled || !form.province}}" bindchange="onCityChange" class="period-picker">
            <view class="field {{isFieldDisabled || !form.province ? 'field-disabled' : ''}}">
              <text class="{{form.city ? '' : 'field-ph'}}">{{form.city || '城市'}}</text>
              <view class="chev"></view>
            </view>
          </picker>
        </view>
      </view>

      <!-- 公司（可搜索下拉） -->
      <view class="am-row am-row-top">
        <text class="am-label label-top">公司</text>
        <view class="am-control">
          <view class="field {{isFieldDisabled ? 'field-disabled' : ''}}" bindtap="toggleCompany">
            <text class="{{form.company ? '' : 'field-ph'}} company-text">{{form.company || '请选择公司'}}</text>
            <view class="chev {{companyOpen ? 'up' : ''}}"></view>
          </view>
          <view wx:if="{{companyOpen && !isFieldDisabled}}" class="company-dropdown">
            <view class="company-search">
              <text class="company-search-icon">🔍</text>
              <input class="company-search-input" value="{{companySearch}}" placeholder="搜索公司" placeholder-class="ph" bindinput="onCompanySearch" focus />
            </view>
            <scroll-view scroll-y class="company-list">
              <view wx:if="{{filteredCompanies.length === 0}}" class="company-empty">无匹配公司</view>
              <view
                wx:for="{{filteredCompanies}}"
                wx:key="*this"
                class="company-item {{form.company === item ? 'active' : ''}}"
                data-value="{{item}}"
                bindtap="selectCompany"
              >{{item}}</view>
            </scroll-view>
          </view>
        </view>
      </view>

      <!-- 客户名称 -->
      <view class="am-row">
        <text class="am-label">客户名称</text>
        <view class="am-control">
          <input class="field field-input {{isFieldDisabled ? 'field-disabled' : ''}} {{errors.customerName ? 'field-error' : ''}}" value="{{form.customerName}}" placeholder="请输入客户名称" placeholder-class="ph" disabled="{{isFieldDisabled}}" bindinput="onCustomerNameInput" />
          <text wx:if="{{errors.customerName}}" class="error-text">{{errors.customerName}}</text>
          <text wx:else class="hint-text">完善客户资料</text>
        </view>
      </view>

      <!-- 课程价格 -->
      <view wx:if="{{showAmount}}" class="am-row">
        <text class="am-label">课程价格</text>
        <view class="am-control">
          <view class="field amount-wrap {{isFieldDisabled ? 'field-disabled' : ''}} {{errors.amount ? 'field-error' : ''}}">
            <text class="amount-symbol">¥</text>
            <input class="amount-input" type="digit" value="{{form.amount}}" placeholder="0.00" placeholder-class="ph" disabled="{{isFieldDisabled}}" bindinput="onAmountInput" />
            <text class="amount-unit">元</text>
          </view>
          <text wx:if="{{errors.amount}}" class="error-text">{{errors.amount}}</text>
        </view>
      </view>

      <!-- 备注说明 -->
      <view class="am-row am-row-top">
        <text class="am-label label-top">备注说明</text>
        <view class="am-control">
          <textarea class="field field-textarea {{isFieldDisabled ? 'field-disabled' : ''}}" value="{{form.remark}}" disabled="{{isFieldDisabled}}" bindinput="onRemarkInput" placeholder="【预约人】&#10;【对应支行】&#10;【负责人】&#10;【其它】" placeholder-class="ph" />
        </view>
      </view>

      <!-- 当前状态（仅查看已有行程） -->
      <view wx:if="{{appointment}}" class="status-card">
        <view class="status-card-head">
          <text class="status-card-title">当前状态</text>
          <view class="status-tags">
            <text class="tag {{form.invoiceStatus === '已开票' ? 'tag-blue' : 'tag-gray'}}">{{form.invoiceStatus}}</text>
            <text class="tag {{form.paymentStatus === '已回款' ? 'tag-green' : (form.paymentStatus === '未回款' ? 'tag-orange' : 'tag-gray')}}">{{form.paymentStatus}}</text>
          </view>
        </view>
        <view wx:if="{{form.invoiceStatus === '已开票'}}" class="status-sub">
          <text class="status-sub-text">发票号：{{form.invoiceNo || '未填写'}}</text>
          <text wx:if="{{isAdmin}}" class="status-sub-link" data-action="invoiceNo" bindtap="openAction">修改</text>
        </view>
        <view wx:if="{{form.invoiceDate}}" class="status-sub">
          <text class="status-sub-text">开票日期：{{form.invoiceDate}}</text>
        </view>
        <view wx:if="{{form.paymentDate}}" class="status-sub">
          <text class="status-sub-text">回款日期：{{form.paymentDate}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作区 -->
    <view class="am-footer">
      <!-- 待确认操作面板 -->
      <view wx:if="{{pendingAction}}" class="action-panel">
        <view class="action-title">
          <view class="action-title-bar"></view>
          <text>{{pendingAction === 'invoice' ? '确认开票' : (pendingAction === 'payment' ? '确认回款' : '修改发票号')}}</text>
        </view>
        <view wx:if="{{pendingAction !== 'invoiceNo'}}" class="action-row">
          <text class="action-label">{{pendingAction === 'invoice' ? '开票日期' : '回款日期'}}</text>
          <picker mode="date" value="{{actionDate}}" bindchange="onActionDateChange" class="action-picker">
            <view class="field"><text>{{actionDate}}</text><view class="chev"></view></view>
          </picker>
        </view>
        <view wx:if="{{pendingAction !== 'payment'}}" class="action-row">
          <text class="action-label">发票号</text>
          <input class="field field-input action-input" value="{{actionInvoiceNo}}" placeholder="选填" placeholder-class="ph" bindinput="onActionInvoiceNoInput" />
        </view>
        <view class="action-btns">
          <view class="btn btn-blue" bindtap="confirmAction">确认</view>
          <view class="btn action-cancel" bindtap="cancelAction">取消</view>
        </view>
      </view>

      <!-- 按钮组 -->
      <view class="footer-btns">
        <block wx:if="{{appointment}}">
          <view
            wx:if="{{!isEditing && !isLocked && canEdit}}"
            class="btn btn-blue footer-btn"
            bindtap="startEdit"
          >修改</view>
          <view
            wx:if="{{isEditing && !isLocked && canEdit}}"
            class="btn btn-blue footer-btn"
            bindtap="submitForm"
          >确认</view>
          <block wx:if="{{isAdmin}}">
            <view
              class="btn footer-btn {{form.invoiceStatus === '已开票' ? 'btn-disabled' : 'btn-blue'}}"
              data-action="invoice"
              bindtap="openAction"
            >已开票</view>
            <view
              class="btn footer-btn {{form.paymentStatus === '已回款' ? 'btn-disabled' : 'btn-green'}}"
              data-action="payment"
              bindtap="openAction"
            >已回款</view>
            <view
              wx:if="{{form.paymentStatus !== '已回款'}}"
              class="btn footer-btn {{form.paymentStatus === '未回款' ? 'btn-disabled' : 'btn-orange'}}"
              bindtap="markUnpaid"
            >未回款</view>
          </block>
          <view
            wx:if="{{!isLocked && canEdit}}"
            class="btn btn-red footer-btn"
            bindtap="onDeleteTap"
          >删除</view>
        </block>
        <view wx:else class="btn btn-blue footer-btn" bindtap="submitForm">确认</view>
      </view>
    </view>
  </view>
</view>

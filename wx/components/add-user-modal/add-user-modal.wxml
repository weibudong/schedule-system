<view wx:if="{{visible}}" class="au-mask" bindtap="close">
  <view class="au-panel" catchtap="noop">
    <view class="au-handle-bar">
      <view class="au-handle"></view>
    </view>
    <view class="au-header">
      <view class="au-title">新增人员</view>
      <view class="au-close" bindtap="close">✕</view>
    </view>

    <view class="au-body">
      <view class="au-row">
        <text class="au-label">姓名</text>
        <view class="au-control">
          <input class="au-field {{errors.name ? 'au-field-error' : ''}}" value="{{name}}" placeholder="请输入姓名" placeholder-class="ph" bindinput="onNameInput" />
          <text wx:if="{{errors.name}}" class="au-error-text">{{errors.name}}</text>
        </view>
      </view>
      <view class="au-row">
        <text class="au-label">手机号</text>
        <view class="au-control">
          <input class="au-field {{errors.phone ? 'au-field-error' : ''}}" type="number" value="{{phone}}" placeholder="请输入手机号" placeholder-class="ph" bindinput="onPhoneInput" />
          <text wx:if="{{errors.phone}}" class="au-error-text">{{errors.phone}}</text>
        </view>
      </view>
      <view class="au-row">
        <text class="au-label">密码</text>
        <view class="au-control">
          <input class="au-field {{errors.password ? 'au-field-error' : ''}}" password value="{{password}}" placeholder="请输入密码" placeholder-class="ph" bindinput="onPasswordInput" />
          <text wx:if="{{errors.password}}" class="au-error-text">{{errors.password}}</text>
        </view>
      </view>
    </view>

    <view class="au-footer">
      <view class="au-btn au-btn-plain" bindtap="close">取消</view>
      <view class="au-btn au-btn-blue" bindtap="submit">确认</view>
    </view>
  </view>
</view>

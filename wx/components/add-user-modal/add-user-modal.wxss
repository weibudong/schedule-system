.au-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.au-panel {
  background: #fff;
  width: 100%;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
}

.au-handle-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 4rpx;
}

.au-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.au-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.au-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.au-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7280;
  font-size: 26rpx;
  border-radius: 50%;
  background: #f3f4f6;
}

.au-close:active {
  background: #e5e7eb;
}

.au-body {
  padding: 8rpx 32rpx 16rpx;
}

.au-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.au-row:last-child {
  border-bottom: none;
}

.au-label {
  font-size: 26rpx;
  color: #9ca3af;
  width: 140rpx;
  flex-shrink: 0;
}

.au-control {
  flex: 1;
  min-width: 0;
}

.au-field {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1f2937;
}

.au-field-error {
  border-color: #fca5a5;
  background: #fef2f2;
}

.au-error-text {
  font-size: 22rpx;
  color: #ef4444;
  margin-top: 10rpx;
  display: block;
}

.au-footer {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #f3f4f6;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}

.au-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.au-btn:active {
  opacity: 0.85;
}

.au-btn-plain {
  background: #f3f4f6;
  color: #4b5563;
}

.au-btn-blue {
  background: #2563eb;
  color: #fff;
}

.ph {
  color: #b6bcc6;
  font-size: 28rpx;
}

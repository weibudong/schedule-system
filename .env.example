# 服务端口
PORT=3001

# 环境标识
NODE_ENV=production

# 数据库备份邮件配置（QQ邮箱）
# 获取QQ邮箱授权码：登录QQ邮箱 -> 设置 -> 账户 -> 开启SMTP服务 -> 获取授权码
MAIL_USER=307641135@qq.com
MAIL_PASS=your_qq_mail_auth_code_here
MAIL_FROM=307641135@qq.com
MAIL_TO=307641135@qq.com

# ===== 对象存储持久化（微信云托管 / CloudBase）=====
# 容器内 SQLite 照常读写，数据库快照自动同步到对象存储做持久化。
# 云托管环境（CLOUDBASE_ENV=true）默认开启，本地默认关闭；也可显式开关。
# STORAGE_SYNC_ENABLED=true

# 启动时从云端恢复快照所需的 fileID。
# 首次部署后，从容器日志里找「★ 快照 fileID」那一行，把值填到这里（云托管「环境变量」），
# 之后再重建实例就能自动恢复数据。未配置时只上传、不恢复。
# DB_SNAPSHOT_FILE_ID=cloud://xxxxxxxx/db/dev.db

# 快照在对象存储里的路径（默认 db/dev.db）
# DB_SNAPSHOT_CLOUD_PATH=db/dev.db

# 写操作后延迟多久上传快照（毫秒，默认 3000，用于合并连续写入）
# DB_SNAPSHOT_DEBOUNCE_MS=3000

# 无写请求时的兜底上传间隔（毫秒，默认 300000 即 5 分钟）
# DB_SNAPSHOT_INTERVAL_MS=300000
